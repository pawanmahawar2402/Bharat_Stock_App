# BharatStock Analyzer Configuration
PROJECT_NAME="BharatStock Analyzer"
VERSION="1.0.0"

# Backend Database
DATABASE_URL="sqlite:///./bharatstock.db"

# Optional LLM API for Narrative Generation (Groq / LLaMA-3.3)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
ENABLE_LLM_NARRATIVE=true

# Cache TTL Settings (Seconds)
CACHE_TTL_PRICES=300
CACHE_TTL_MACRO=3600
CACHE_TTL_FINANCIALS=86400
CACHE_TTL_SWING=1800

# Benchmark Sovereign Yield Defaults
INDIA_10Y_GSEC_DEFAULT=6.80
EQUITY_RISK_PREMIUM_DEFAULT=6.50
